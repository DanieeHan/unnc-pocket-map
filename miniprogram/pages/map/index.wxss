/* Nottingham Blue #10263B; official tints #405162 / #707D89 / #CFD4D8 / #F3F4F5. */
.app{display:flex;flex-direction:column;overflow:hidden;background:#fff;color:#10263b}
.topline{height:80rpx;flex-shrink:0;display:flex;align-items:center;padding:0 36rpx;background:#10263b;color:#fff}
.wordmark{font-size:31rpx;font-weight:800;letter-spacing:1rpx}.wordmark-light{font-size:21rpx;letter-spacing:0;font-weight:400;padding-left:15rpx;border-left:1px solid #707d89;margin-left:15rpx}
.heading{display:flex;justify-content:space-between;align-items:center;padding:26rpx 36rpx 22rpx;flex-shrink:0}.eyebrow{display:block;font-size:16rpx;letter-spacing:1.4rpx;font-weight:500;color:#405162;line-height:1.6}.title{display:block;font-size:46rpx;letter-spacing:-1rpx;font-weight:650;margin-top:3rpx}.help{width:62rpx;height:62rpx;border:1px solid #cfd4d8;border-radius:4rpx;font-size:28rpx;color:#405162;display:flex;align-items:center;justify-content:center}
.searchbox{margin:0 36rpx;display:flex;align-items:center;background:#f3f4f5;border:1px solid #cfd4d8;border-radius:4rpx;height:82rpx;padding:0 22rpx;flex-shrink:0}.search-icon{font-size:44rpx;line-height:1;margin-right:16rpx}.searchbox input{flex:1;font-size:24rpx;height:70rpx}.search-end{font-size:21rpx;color:#405162;border-left:1px solid #cfd4d8;padding-left:20rpx}.clear{font-size:36rpx;width:48rpx}
.categories{width:100%;height:88rpx;flex-shrink:0;white-space:nowrap;border-bottom:1px solid #cfd4d8}.category-inner{display:flex;padding:12rpx 24rpx 0;height:100%}.chip{flex:1;flex-shrink:0;padding:18rpx 12rpx;font-size:25rpx;color:#405162;display:flex;align-items:center;justify-content:center;line-height:1.35;border-bottom:5rpx solid transparent}.chip.active{border-bottom-color:#10263b;color:#10263b;font-weight:650}.chip-symbol{display:none}
.content{flex:1;min-height:0;position:relative}.map-stage{position:absolute;inset:0;background:#f3f4f5;overflow:hidden}.map-area{width:100%;height:100%;overflow:hidden}.map-sheet{width:600px;height:579px;position:absolute}.campus-art{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.place-marker{position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;z-index:2;white-space:nowrap;cursor:pointer}.pin{height:34px;min-width:34px;padding:0 4px;background:#10263b;border:3px solid #fff;border-radius:50%;color:#fff;font-size:13px;font-weight:700;display:flex;justify-content:center;align-items:center;box-shadow:0 1px 3px #10263b20}.pin-label{background:#ffffffed;padding:4px 7px;border-radius:2px;margin-top:2px;font-size:14px;font-weight:600;color:#10263b}.selected{z-index:5}.selected .pin{background:#10263b;box-shadow:0 0 0 6px #9fa8b188}.selected .pin-label{background:#10263b;color:white}
.map-stamp{position:absolute;left:26rpx;top:24rpx;display:flex;align-items:center;gap:10rpx;font-size:18rpx;background:#fffffff2;border:1px solid #dfe3e6;padding:12rpx 16rpx;border-radius:3rpx;color:#405162;pointer-events:none}.live-dot{width:8rpx;height:8rpx;background:#10263b}.stamp-light{display:none}.compass{position:absolute;right:34rpx;top:24rpx;display:flex;flex-direction:column;align-items:center;color:#405162;pointer-events:none;transform:rotate(-35deg)}.compass-n{font-size:16rpx;font-weight:700}.compass-arrow{font-size:43rpx;line-height:1.1}.map-tools{position:absolute;right:24rpx;bottom:70rpx;border:1px solid #cfd4d8;border-radius:4rpx;background:#fff;overflow:hidden}.map-tools button{width:76rpx;height:76rpx;font-size:35rpx;display:flex;align-items:center;justify-content:center}.map-tools button+button{border-top:1px solid #dfe3e6}.map-caption{position:absolute;bottom:20rpx;left:26rpx;right:26rpx;color:#405162;font-size:18rpx;display:flex;justify-content:space-between;pointer-events:none}.map-caption text{color:#405162}
.bottom-card{background:#fff;border-top:1px solid #dfe3e6;z-index:7;position:relative;flex-shrink:0;height:166rpx}.discovery-card{display:flex;align-items:center;justify-content:space-between;padding:24rpx 36rpx}.discovery-title{display:block;font-size:30rpx;font-weight:600;margin:4rpx 0 8rpx}.discovery-sub{font-size:22rpx;color:#405162}.discovery-card .eyebrow{font-size:16rpx;color:#707d89;letter-spacing:1.5rpx}.discover-button{height:78rpx;width:78rpx;background:#10263b;color:white;border-radius:3rpx;font-size:39rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.tabbar{display:flex;background:#fff;border-top:1px solid #cfd4d8;padding:15rpx 10rpx max(18rpx,env(safe-area-inset-bottom));flex-shrink:0;z-index:8;min-height:110rpx}.tab{flex:1;display:flex;align-items:center;flex-direction:column;gap:6rpx;font-size:20rpx;color:#707d89}.tab-icon{font-size:35rpx;line-height:1.2}.tab.current{color:#10263b;font-weight:650}.tab.current .tab-icon{color:#10263b}
.bottom-card.has-detail{height:218rpx}.detail-card{padding:20rpx 32rpx}.detail-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.detail-title{display:block;font-size:32rpx;font-weight:650;margin:4rpx 0}.detail-en{font-size:18rpx;color:#405162;display:block;max-width:580rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.close{height:55rpx;width:55rpx;border-radius:3rpx;background:#f3f4f5;font-size:34rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}.detail-actions{display:flex;gap:12rpx;margin-top:15rpx}.primary{background:#10263b;color:#fff;border-radius:4rpx;padding:18rpx 24rpx;font-size:23rpx;display:flex;justify-content:space-between;align-items:center;gap:25rpx}.detail-actions .primary{flex:1}.save{padding:16rpx 24rpx;background:#fff;border:1px solid #cfd4d8;border-radius:4rpx;font-size:23rpx}.save.saved{color:#10263b;background:#e8edf1;border-color:#10263b}.info-button{font-size:22rpx;padding:16rpx 12rpx;color:#405162}
.list-panel{width:100%;height:100%;box-sizing:border-box;background:#fff;padding:0 32rpx}.list-title{display:flex;justify-content:space-between;align-items:center;padding:28rpx 4rpx 20rpx;font-size:31rpx;font-weight:650}.count{font-size:21rpx;color:#405162;font-weight:400}.app .place-row{display:flex;width:100%;max-width:none;align-items:center;text-align:left;padding:25rpx 5rpx;border-bottom:1px solid #e4e7ea;gap:22rpx}.row-number{width:72rpx;height:72rpx;border-radius:3rpx;background:#f3f4f5;display:flex;align-items:center;justify-content:center;font-size:25rpx;color:#10263b;font-weight:650;flex-shrink:0}.row-copy{min-width:0;flex:1}.row-name{display:block;font-size:28rpx;font-weight:600}.row-en{display:block;color:#405162;font-size:19rpx;margin-top:8rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.row-arrow{font-size:29rpx;color:#405162}.list-foot{padding:32rpx 0;font-size:20rpx;text-align:center;color:#707d89}.empty{text-align:center;padding:80rpx 12rpx;display:flex;flex-direction:column;align-items:center;gap:22rpx}.empty-icon{font-size:90rpx;color:#9fa8b1}.empty-title{font-size:28rpx;font-weight:600}.empty-copy{font-size:22rpx;color:#405162;line-height:1.8}.secondary{border:1px solid #cfd4d8;border-radius:4rpx;padding:20rpx 32rpx;margin-top:15rpx;font-size:24rpx}
.scrim{position:fixed;inset:0;background:#10263b75;z-index:20;display:flex;align-items:flex-end}.guide-sheet{background:#fff;width:100%;border-radius:12rpx 12rpx 0 0;padding:18rpx 36rpx max(35rpx,env(safe-area-inset-bottom));max-height:85%;overflow-y:auto}.sheet-handle{height:6rpx;width:64rpx;background:#cfd4d8;border-radius:5rpx;margin:0 auto 27rpx}.guide-en{color:#405162;font-size:21rpx;display:block;margin:10rpx 0 28rpx;line-height:1.5}.guide-intro{display:block;font-size:28rpx;margin:25rpx 0;font-weight:600}.guide-text{display:block;font-size:25rpx;line-height:1.85;color:#405162}.tags{display:flex;gap:12rpx}.tags text{font-size:20rpx;border-radius:2rpx;padding:8rpx 16rpx;background:#f3f4f5;color:#405162}.notice{border-left:5rpx solid #10263b;background:#f3f4f5;padding:24rpx;margin:28rpx 0;color:#405162;font-size:22rpx;line-height:1.85}.notice-title{display:block;font-weight:650;color:#10263b;margin-bottom:8rpx}.full{width:100%;justify-content:center}.address-button{font-size:22rpx;color:#405162;margin-top:15rpx;padding:15rpx}

.pin{height:27px;min-width:27px;border-width:2px;font-size:12px;position:relative}.building-plus{position:absolute;right:-4px;top:-5px;font-size:10px;line-height:12px;width:12px;height:12px;border-radius:50%;background:#fff;color:#10263b;border:1px solid #10263b}.pin-label{max-width:160px;white-space:normal;text-align:center;line-height:1.35;font-size:13px}.row-hint{font-size:22rpx;font-weight:400;color:#405162}.related{border-top:1px solid #cfd4d8;margin-top:25rpx;padding-top:22rpx}.related-title{display:block;font-size:24rpx;font-weight:600;margin-bottom:10rpx}.related-place{display:flex;gap:18rpx;align-items:center;text-align:left;padding:19rpx 0;border-bottom:1px solid #e5e8eb;font-size:23rpx}.related-place text:last-child{margin-left:auto}.related-code{width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;background:#f3f4f5;color:#10263b}

/* Camera coordinates refer to the image's top-left; labels never move the pin. */
.map-area{position:relative;touch-action:none}.map-sheet{transform-origin:0 0;will-change:transform}.place-marker{width:28px;height:28px}.place-marker .pin{box-sizing:border-box;width:28px;min-width:28px;height:28px;flex-shrink:0}.pin-label{position:absolute;top:32px;left:50%;transform:translateX(-50%);margin:0;width:max-content;max-width:160px}.map-sheet{user-select:none}

/* Override the v2 native button sizing explicitly; keep cards in normal flow. */
.map-area{z-index:0}
@keyframes map-item-appear{from{opacity:0}to{opacity:1}}
@keyframes map-menu-appear{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.marker-layer .place-marker{animation:map-item-appear 140ms ease-out both}
.map-service-popup{animation:map-menu-appear 160ms ease-out both}
.pin{transition:background-color 140ms ease-out,box-shadow 140ms ease-out}
@media(prefers-reduced-motion:reduce){.marker-layer .place-marker,.map-service-popup{animation:none}.pin{transition:none}}
.service-badge{position:absolute;right:-6px;top:-6px;min-width:12px;height:12px;padding:0 2px;box-sizing:border-box;border:1px solid #fff;border-radius:7px;background:#10263b;color:#fff;font-size:8px;line-height:10px;text-align:center}
.map-popup-layer{position:absolute;inset:0;z-index:9;pointer-events:none}
.map-service-popup{position:absolute;display:flex;flex-direction:column;pointer-events:auto;background:#fff;border:1px solid #cfd4d8;border-radius:6px;box-shadow:0 4px 18px #10263b20;overflow:hidden;box-sizing:border-box}
.map-popup-header{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-bottom:1px solid #e5e8eb;flex-shrink:0}
.map-popup-title{display:block;font-size:12px;font-weight:600;line-height:18px}
.map-popup-sub{display:block;font-size:10px;color:#707d89;line-height:16px}
.app .map-popup-close{width:28px;height:28px;flex:0 0 28px;padding:0;margin:0;background:#f3f4f5;font-size:18px;line-height:28px}
.map-popup-list{flex:1;height:0;min-height:0}
.app .map-popup-item{display:flex;align-items:center;justify-content:space-between;width:100%;padding:10px 12px;gap:8px;text-align:left;border-bottom:1px solid #edf0f2;background:#fff;font-size:12px;line-height:18px}
.map-popup-item>view{flex:1;min-width:0}
.map-popup-item text{display:block}
.map-popup-en{display:block;font-size:10px;line-height:15px;color:#707d89;white-space:normal}
.service-drawer{flex-shrink:0;background:#fff;border-top:1px solid #cfd4d8}
.app .service-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;padding:22rpx 32rpx;text-align:left;background:#fff;line-height:1.4}
.service-toggle-title{font-size:25rpx;font-weight:600;color:#10263b}
.service-toggle-count{font-size:20rpx;color:#707d89;margin-left:16rpx}
.service-toggle-action{font-size:22rpx;color:#405162;white-space:nowrap;flex-shrink:0}
.service-list{height:26vh;max-height:230px;border-top:1px solid #e5e8eb}
.service-group-title{display:block;padding:18rpx 32rpx 10rpx;font-size:21rpx;font-weight:600;background:#f3f4f5;color:#405162}
.app .service-list-row{display:flex;align-items:center;justify-content:space-between;width:100%;padding:17rpx 32rpx;border-bottom:1px solid #edf0f2;text-align:left;gap:16rpx;background:#fff}
.service-list-row>view{min-width:0;flex:1}
.service-list-name{display:block;font-size:25rpx;font-weight:600;line-height:1.5}
.service-list-en{display:block;font-size:20rpx;color:#707d89;line-height:1.5}
.service-locate{font-size:21rpx;flex-shrink:0;color:#405162}
.service-list-note{display:block;padding:20rpx 32rpx;font-size:20rpx;line-height:1.6;color:#707d89}
.marker-layer{position:absolute;inset:0;pointer-events:none;z-index:2}
.marker-layer .place-marker{pointer-events:auto}
.marker-layer .pin-label{transform:none;box-sizing:border-box;height:20px;padding:3px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:10px;line-height:14px}
.marker-residence:not(.selected) .pin{background:#fff;color:#707d89;border:1px solid #b8c1c9;box-shadow:none;font-size:11px}
.marker-residence:not(.selected) .building-plus{display:none}
.service-overlay{position:absolute;inset:0;pointer-events:none;z-index:4}
.service-connection{position:absolute;height:1px;background:#707d89;transform-origin:0 50%;pointer-events:none}
.service-area-card{position:absolute;height:70px;padding:9px 10px;background:#fff;border:1px solid #cfd4d8;border-left:3px solid #10263b;border-radius:4px;box-shadow:0 2px 6px #10263b12;pointer-events:auto;cursor:pointer}
.service-area-heading{display:flex;justify-content:space-between;color:#707d89;font-size:9px;font-weight:600;letter-spacing:.5px;line-height:14px}
.service-brands{display:block;white-space:pre-line;font-size:11px;line-height:18px;color:#10263b;font-weight:600;letter-spacing:-.2px}
.selected .pin{box-shadow:0 0 0 3px #9fa8b188}
.service-shortcuts{display:flex;align-items:center;gap:12rpx;padding:14rpx 24rpx;border-bottom:1px solid #dfe3e6;flex-shrink:0;background:#fff}
.service-caption{font-size:20rpx;color:#707d89;flex-shrink:0}
.app .service-shortcuts button{width:auto;min-width:0;flex:1;padding:10rpx 6rpx;font-size:21rpx;line-height:1.4;background:#f3f4f5;color:#10263b;white-space:nowrap;border-radius:4rpx}
.app .service-shortcuts .all-services{flex:1.5;background:#10263b;color:#fff}
.app button{min-width:0;margin:0;box-sizing:border-box}
.app .help{width:62rpx;flex:0 0 62rpx;padding:0}
.app .close{width:56rpx;height:56rpx;flex:0 0 56rpx;padding:0}
.app .discover-button{width:78rpx;flex:0 0 78rpx;padding:0}
.app .chip,.app .tab{width:0;flex:1 1 0}
.app .clear{width:48rpx;flex:0 0 48rpx;padding:0}
.app .map-tools button{width:76rpx;padding:0}
.bottom-card,.bottom-card.has-detail{height:auto}
.detail-heading>view{flex:1;min-width:0}
.detail-heading>.detail-title{flex:1;min-width:0}
.detail-title{line-height:1.4;overflow-wrap:break-word}
.detail-en{max-width:100%;line-height:1.5}
.detail-actions{align-items:stretch}
.app .detail-actions .primary{width:0;min-width:0;flex:1 1 0;padding:16rpx 18rpx;gap:8rpx;white-space:nowrap;justify-content:center}
.app .detail-actions .save{width:176rpx;flex:0 0 176rpx;padding:16rpx 8rpx;white-space:nowrap;display:flex;align-items:center;justify-content:center}
.app .detail-actions .info-button{width:88rpx;flex:0 0 88rpx;padding:16rpx 8rpx;white-space:nowrap;display:flex;align-items:center;justify-content:center}

/* Single foreground location fix; world camera also moves the accuracy radius. */
.user-location-layer{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:3}
.user-location{position:absolute;pointer-events:none}
.location-accuracy{position:absolute;left:0;top:0;transform:translate(-50%,-50%);border-radius:50%;background:rgba(30,110,190,.12);border:1px solid rgba(30,110,190,.25);box-sizing:border-box}
.location-dot{position:absolute;left:0;top:0;transform:translate(-50%,-50%);width:12px;height:12px;border-radius:50%;background:#2474b9;border:3px solid white;box-shadow:0 0 0 1px #2474b9}
.location-status{position:absolute;left:26rpx;bottom:64rpx;max-width:calc(100% - 140rpx);background:#fffffff2;color:#405162;padding:10rpx 14rpx;font-size:20rpx;border:1px solid #cfd4d8;z-index:8}

/* Keep the place reference visible before copying or saving it. */
.detail-location{margin-top:12rpx;line-height:1.5;color:#405162;font-size:20rpx}.detail-location-hint{display:block;font-weight:600}.detail-location-note{display:block;color:#707d89}
