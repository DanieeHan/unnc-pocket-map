page{background:#f3f4f5;color:#10263b}.collector{padding:32rpx;padding-bottom:80rpx}.title{font-size:40rpx;font-weight:700;display:block}.intro,.message{display:block;font-size:25rpx;line-height:1.7;margin:20rpx 0;color:#405162}input{background:white;border:1px solid #cfd4d8;padding:20rpx;margin:24rpx 0}radio-group{display:flex;gap:24rpx;margin:24rpx 0;font-size:26rpx}.calibration-map{position:relative;width:100%;aspect-ratio:600/579;background:#fff}.calibration-map image{width:100%;height:100%;position:absolute}.cross{position:absolute;transform:translate(-50%,-50%);color:#005caa;font-size:40rpx;background:#fff;border-radius:50%;line-height:1}button{background:#10263b;color:white;font-size:27rpx;margin-top:18rpx}.row{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;border-bottom:1px solid #cfd4d8;padding:12rpx 0}.row button{width:auto;margin:0;font-size:22rpx;padding:0 18rpx;background:white;color:#405162}
